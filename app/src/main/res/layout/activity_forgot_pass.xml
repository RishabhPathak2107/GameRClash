<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#130016">
    <!-- Welcome Text -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Forget Password?"
        android:textColor="#FFFFFF"
        android:textSize="28dp"
        android:layout_gravity="center_horizontal"
        android:textStyle="bold"
        android:layout_marginTop="40dp" />

    <LinearLayout
        android:layout_margin="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical">



        <!-- Username Field -->
        <EditText
            android:id="@+id/emailInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter Email Id"
            android:textSize="16dp"
            android:paddingLeft="16dp"
            android:paddingBottom="13dp"
            android:paddingTop="13dp"
            android:background="@drawable/rounded_edittext"
            android:textColorHint="#BDBDBD"
            android:textColor="#000000"
            android:layout_marginTop="32dp" />


        <!-- Login Button with Arrow -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/btn_purple_rounded"
            android:layout_marginTop="32dp">

            <TextView
                android:id="@+id/resetBtn"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="CONFIRM"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16dp"
                android:gravity="center"
                android:textAllCaps="false"
                android:layout_centerInParent="true" /> <!-- 👈 Centered in parent -->

            <ImageView
                android:id="@+id/arrowIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/arrow_right2"
                android:layout_alignParentEnd="true"
                android:rotationX="-1"
                android:scaleType="fitXY"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:background="@drawable/round_white_circle"
                android:padding="8dp" />
        </RelativeLayout>

    </LinearLayout>

</LinearLayout>
