<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/main"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_height="match_parent"
    android:layout_width="match_parent"
    android:background="#011223">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#031d38">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/back_button"
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_centerVertical="true"
                android:src="@drawable/arrow_white"
                android:contentDescription="Back" />

            <TextView
                android:id="@+id/toolbar_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="LEADERBOARD"
                android:textSize="14dp"
                android:fontFamily="sans-serif-thin"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </RelativeLayout>
    </androidx.appcompat.widget.Toolbar>

    <!-- Top 3 Players -->
    <LinearLayout
        android:id="@+id/top_three_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="20dp"
        android:paddingHorizontal="12dp">

        <!-- Rank 2 -->
        <LinearLayout
            android:id="@+id/rank2_layout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/rank2_img"
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:src="@drawable/silver" />

            <TextView
                android:id="@+id/second_name"
                android:text="Jackson"
                android:textColor="#C0C0C0"
                android:textSize="14dp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/second_score"
                android:text="1847"
                android:textColor="#A0A0A0"
                android:textSize="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Rank 1 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/rank1_img"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/gold" />

            <TextView
                android:id="@+id/first_name"
                android:text="Eiden"
                android:textColor="#FFD700"
                android:textStyle="bold"
                android:textSize="16dp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/first_score"
                android:text="2430"
                android:textColor="#CCCCCC"
                android:textSize="14dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Rank 3 -->
        <LinearLayout
            android:id="@+id/rank3_layout"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/rank3_img"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@drawable/bronze" />

            <TextView
                android:id="@+id/third_name"
                android:text="Emma Aria"
                android:textColor="#CD7F32"
                android:textSize="14dp"
                android:layout_marginTop="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/third_score"
                android:text="1674"
                android:textColor="#A0A0A0"
                android:textSize="12dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/leaderboard_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:padding="8dp" />
</LinearLayout>
