<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#130016">

    <LinearLayout
        android:layout_margin="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Welcome Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome to,\nLogin"
            android:textColor="#FFFFFF"
            android:textSize="28dp"
            android:textStyle="bold"
            android:layout_marginTop="40dp" />

        <!-- Username Field -->
        <EditText
            android:id="@+id/email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Email/Mobile No/Username"
            android:textSize="16dp"
            android:paddingLeft="16dp"
            android:paddingBottom="13dp"
            android:paddingTop="13dp"
            android:background="@drawable/rounded_edittext"
            android:textColorHint="#BDBDBD"
            android:textColor="#000000"
            android:layout_marginTop="32dp" />

        <!-- Resend Email Verification -->
        <TextView
            android:id="@+id/tvResendVerification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Resend Verification Email"
            android:textColor="#FF9800"
            android:textSize="14dp"
            android:visibility="gone"
        android:layout_marginTop="10dp"
        android:layout_gravity="center_horizontal" />

        <!-- Password Field + Show -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounded_edittext"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/password"
                android:layout_width="0dp"
                android:textSize="16dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Password"
                android:paddingLeft="16dp"
                android:paddingBottom="13dp"
                android:paddingTop="13dp"
                android:inputType="textPassword"
                android:textColorHint="#BDBDBD"
                android:textColor="#000000"
                android:background="@android:color/transparent" />

            <TextView
                android:id="@+id/tvShowPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Show"
                android:textSize="14dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:paddingEnd="16dp" />
        </LinearLayout>

        <!-- Forgot Password -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot Password?"
            android:textColor="#CCCCCC"
            android:textSize="14dp"
            android:layout_gravity="end"
            android:layout_marginTop="8dp" />

        <!-- Login Button with Arrow -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/btn_purple_rounded"
            android:layout_marginTop="32dp">

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="LOGIN"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16dp"
                android:gravity="center"
                android:textAllCaps="false"
                android:layout_centerInParent="true" /> <!-- 👈 Centered in parent -->

            <ImageView
                android:id="@+id/arrowIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/arrow_right2"
                android:layout_alignParentEnd="true"
                android:rotationX="-1"
                android:scaleType="fitXY"
                android:layout_centerVertical="true"
                android:layout_marginEnd="5dp"
                android:background="@drawable/round_white_circle"
                android:padding="8dp" />
        </RelativeLayout>

        <!-- OR Login with -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="or Login with"
            android:textColor="#FFFFFF"
            android:textSize="14dp"
            android:visibility="gone"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp" />

        <!-- Google Login -->
        <ImageView
            android:id="@+id/btnGoogle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:visibility="gone"
            android:src="@drawable/google_icon"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp" />

        <!-- Sign Up Link -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have an account? "
            android:textColor="#FFFFFF"
            android:layout_marginTop="30dp"
            android:textSize="14dp"
            android:gravity="center"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:id="@+id/btnSignup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign Up"
            android:textColor="#FF9800"
            android:textSize="14dp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />
    </LinearLayout>
</ScrollView>
